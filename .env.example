# ═══════════════════════════════════════════════════════════════
# LeanOn — Required Environment Variables
# Set ALL of these in Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Supabase (supabase.com → project → Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # NEVER expose publicly

# ── Razorpay (dashboard.razorpay.com → Settings → API Keys) ────
# ⚠️  REQUIRED for wallet recharge to show and work
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...             # Webhooks → your webhook → Secret

# ── Agora (console.agora.io → project → App ID + App Certificate)
# ⚠️  REQUIRED for voice calls to work
NEXT_PUBLIC_AGORA_APP_ID=...
AGORA_APP_CERTIFICATE=...               # Voice token signing key (server only)

# ── Resend (resend.com → API Keys) ─────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=LeanOn <noreply@leanon.app> # Must use verified domain

# ── Admin ───────────────────────────────────────────────────────
# ADMIN_EMAIL does THREE things: (1) receives crisis/self-harm alerts
# (app/api/report), (2) grants admin access to whoever signs in with this
# email (lib/require-admin.ts), (3) is the fallback recipient for the contact
# form. Keep it a private inbox you monitor — NOT a public support address.
ADMIN_EMAIL=your@email.com              # Admin identity + crisis alerts (private)
ADMIN_SECRET=long-random-string         # Password for /admin dashboard login (x-admin-password header)

# Public "reach us" inbox for the /contact form. Set this so contact-form
# messages go to support@leanon.app WITHOUT touching admin identity or crisis
# routing above. Falls back to ADMIN_EMAIL when unset.
CONTACT_EMAIL=support@leanon.app

# ── Cron ────────────────────────────────────────────────────────
CRON_SECRET=long-random-string          # Vercel cron auth for /api/sessions/cleanup

# ── Analytics (optional) ────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_BING_VERIFICATION=your-key

# ── Local dev only ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bot protection (Cloudflare Turnstile CAPTCHA) ────────────────────────────
# Stops bots triggering SMS OTP sends, which cost real money on MSG91.
# Get both keys free at: https://dash.cloudflare.com → Turnstile → Add site
#   - Site key   → here (public, safe to expose)
#   - Secret key → Supabase Dashboard → Authentication → Attack Protection →
#                  Enable CAPTCHA protection → Provider: Turnstile
# Leave UNSET to disable CAPTCHA entirely (OTP flow keeps working as before).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
# Lets a listener receive a push alert for a new session request even with no
# LeanOn tab open (locked phone, app backgrounded). Fully optional — with any
# of these unset, push is silently skipped and the in-app realtime alert
# (ListenerPresence / dashboard) is still fully functional on its own.
#
# Setup: Firebase Console (console.firebase.google.com) → create/select a
# project → Project settings (gear icon):
#   1. General tab → "Your apps" → add a Web app (</>) if none exists →
#      copy the firebaseConfig values into the NEXT_PUBLIC_FIREBASE_* vars below.
#   2. Cloud Messaging tab → "Web configuration" → "Web Push certificates" →
#      Generate key pair → that's NEXT_PUBLIC_FIREBASE_VAPID_KEY.
#   3. Service accounts tab → Generate new private key → downloads a JSON file
#      with the FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
#      values below (server-side — used by lib/firebase-admin.ts to SEND pushes).
#      FIREBASE_PRIVATE_KEY: paste with literal \n for newlines (one line total).

# Client (public — safe to expose; same category as NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server (secret — used to SEND pushes via the Admin SDK, never exposed client-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Phone sign-in via the MSG91 OTP WIDGET (no DLT) ──────────────────────────
# India's DLT regime blocks the "Supabase generates the OTP, MSG91 delivers it"
# hook below (it needs a DLT-approved template → an active GST LeanOn no longer
# has — see CLAUDE.md). MSG91's only no-DLT product is the OTP Widget: MSG91
# generates AND verifies the OTP and returns a token; our server verifies that
# token and mints the Supabase session (app/api/auth/phone-widget/route.ts,
# app/auth/page.tsx). THIS is the live phone-auth path.
#
#   Client (public, embedded in the browser — from MSG91 → Widget → Client Side):
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
#   Must match the OTP length configured on the widget in the MSG91 dashboard
#   (default 6). Set the dashboard widget to 6 digits, or change this to match.
NEXT_PUBLIC_MSG91_OTP_LENGTH=6
#   Server secret used to verify the widget token (MSG91 → Auth Keys). The widget
#   verify call comes from Vercel's rotating IPs, so this auth key MUST have
#   IP Security turned OFF, or every verification fails.
MSG91_WIDGET_AUTHKEY=
#   Optional. Overrides the verify endpoint for testing. Leave unset in prod.
MSG91_VERIFY_URL=

# ── LEGACY: SMS OTP delivery (MSG91 via Supabase Send SMS hook) ───────────────
# Superseded by the OTP Widget above (DLT blocked this path). Kept for the day a
# DLT-approved template + GST exist again. Supabase Auth natively supports only
# Twilio / Twilio Verify / MessageBird / Vonage / Textlocal; MSG91 is not on
# that list, so this routed OTP delivery through the Send SMS auth hook at
#   POST /api/webhooks/supabase-sms
#
# Here Supabase STILL generates/verifies/rate-limits the OTP and mints the
# session — the hook only replaces delivery. Turning the hook off in the
# Supabase dashboard reverts to the built-in provider with no deploy.
#
# Supabase Dashboard → Authentication → Hooks → Send SMS hook:
#   Type: HTTPS   URL: https://www.leanon.app/api/webhooks/supabase-sms
#   then "Generate secret" and paste it below verbatim (keep the v1,whsec_ prefix).
SUPABASE_SMS_HOOK_SECRET=

# MSG91 dashboard → Auth Key (SERVER-SIDE SECRET — never expose to the browser)
MSG91_AUTHKEY=
# The Flow / template id of your DLT-approved OTP template
MSG91_FLOW_ID=
# Name of the placeholder inside that DLT template which receives the code.
# Defaults to "otp" — only set this if your approved template names it differently.
MSG91_OTP_VAR=otp

# Optional. Comma-separated numbers that are ACCEPTED but never actually sent,
# so QA does not burn credits. Leave unset in production.
SMS_HOOK_BLOCKED_PHONES=
# Optional. Overrides the MSG91 endpoint for local testing against a stand-in
# server (MSG91 has no sandbox). Leave unset in production.
MSG91_FLOW_URL=
